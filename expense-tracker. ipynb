      "source": [
        "import pandas as pd\n",
        "csv_text = \"\"\"date,item,amount\n",
        "2026-11-01,Food,150\n",
        "2026-11-02,Travel,80\n",
        "2026-11-03,Food,200\n",
        "2026-11-04,Recharge,299\n",
        "\"\"\"\n",
        "with open(\"expenses.csv\", \"w\") as f:\n",
        "    f.write(csv_text)\n",
        "\n",
        "df = pd.read_csv(\"expenses.csv\")\n",
        "print(df)\n",
        "print(df.groupby(\"item\")[\"amount\"].sum())\n",
        "totals = df.groupby(\"item\")[\"amount\"].sum().sort_values(ascending=False)\n",
        "print(totals)\n",
        "totals.plot(kind=\"bar\")"
